{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KV-cache saved worker and coordinator result schema",
  "description": "Matches primary-probe-v1 records and coordinator-v1 probe_result envelopes. Other journal events follow DATA_CONTRACT.md. Cross-field identity, counter ordering, immutable references and scientific compatibility are checked by the analysis/gate code.",
  "oneOf": [
    {
      "$ref": "#/$defs/worker"
    },
    {
      "$ref": "#/$defs/coordinator_result"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "worker": {
      "type": "object",
      "required": [
        "schema_version",
        "probe_id",
        "length",
        "repeat",
        "allocator",
        "execution_policy",
        "protocol_sha256",
        "config_sha256",
        "status",
        "stage",
        "snapshots",
        "attempt_kind",
        "measurement",
        "peak_allocated_bytes",
        "peak_reserved_bytes",
        "pid",
        "started_unix_ns",
        "finished_unix_ns",
        "code_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "primary-probe-v1"
        },
        "probe_id": {
          "type": "string",
          "format": "uuid"
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "repeat": {
          "type": "integer",
          "minimum": 1
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "allocator": {
          "enum": [
            "default",
            "expandable"
          ]
        },
        "attempt_kind": {
          "enum": [
            "safe",
            "deliberate"
          ]
        },
        "measurement": {
          "enum": [
            "primary",
            "chunked_dynamic",
            "static_cache",
            "workspace_control",
            "kernel_trace"
          ]
        },
        "status": {
          "enum": [
            "success",
            "incomplete",
            "cuda_oom",
            "unsupported_backend",
            "unsupported_allocator",
            "environment_drift",
            "runtime_mismatch",
            "timeout",
            "error",
            "telemetry_error"
          ]
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "snapshots": {
          "type": "object"
        },
        "execution_policy": {
          "type": "object"
        },
        "protocol_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "code_sha256": {
          "type": "object",
          "required": [
            "probe.py",
            "telemetry.py"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "peak_allocated_bytes": {
          "$ref": "#/$defs/nullable_bytes"
        },
        "peak_reserved_bytes": {
          "$ref": "#/$defs/nullable_bytes"
        },
        "started_unix_ns": {
          "type": "integer",
          "minimum": 1
        },
        "finished_unix_ns": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "success"
              }
            }
          },
          "then": {
            "required": [
              "weights",
              "cache",
              "logits",
              "gpu_uuid"
            ],
            "properties": {
              "peak_allocated_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "peak_reserved_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "weights": {
                "type": "object"
              },
              "cache": {
                "type": "object"
              },
              "logits": {
                "type": "object"
              },
              "gpu_uuid": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "coordinator_result": {
      "type": "object",
      "required": [
        "event",
        "sequence",
        "run_id",
        "probe_id",
        "point_key",
        "timestamp_utc",
        "request",
        "status",
        "metrics",
        "process"
      ],
      "properties": {
        "event": {
          "const": "probe_result"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "probe_id": {
          "type": "string",
          "format": "uuid"
        },
        "point_key": {
          "$ref": "#/$defs/sha256"
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        },
        "request": {
          "type": "object"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/worker"
            }
          ]
        },
        "process": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "success"
              }
            }
          },
          "then": {
            "properties": {
              "metrics": {
                "$ref": "#/$defs/worker"
              }
            }
          }
        }
      ]
    }
  }
}
